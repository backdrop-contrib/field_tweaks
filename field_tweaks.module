<?php

/**
 * @file
 * Field Tweaks provides small, opt-in improvements for field UI and storage.
 */

/**
 * Implements hook_help().
 */
function field_tweaks_help($path, $arg) {
  if ($path === 'admin/help#field_tweaks') {
    return '<p>Provides optional helpers for field machine names and trimming text values.</p>';
  }
}

/**
 * Alter the add-field UI to suggest bundle-prefixed machine names.
 *
 * Provides opt-in machine name suggestions that include a configurable bundle
 * prefix (backdrop/backdrop-issues#6172), controlled per content type.
 */
function field_tweaks_form_field_ui_field_overview_form_alter(&$form, &$form_state) {
  $entity_type = isset($form['#entity_type']) ? $form['#entity_type'] : NULL;
  $bundle = isset($form['#bundle']) ? $form['#bundle'] : NULL;

  if (!$entity_type || !$bundle) {
    return;
  }

  $config = config('field_tweaks.settings');
  $bundle_settings = $config->get('bundle_settings');
  if (empty($bundle_settings[$bundle]['suggest_bundle_prefix'])) {
    return;
  }

  $raw_prefix = isset($bundle_settings[$bundle]['machine_name_prefix']) ? $bundle_settings[$bundle]['machine_name_prefix'] : $bundle;
  $prefix = field_tweaks_sanitize_machine_prefix($raw_prefix);
  if ($prefix === '') {
    return;
  }

  if (empty($form['fields']['_add_new_field']['field_name'])) {
    return;
  }

  $machine = &$form['fields']['_add_new_field']['field_name'];
  $display_prefix = 'field_' . $prefix . '_';
  $max_length = 32 - strlen($display_prefix);
  if ($max_length < 1) {
    $max_length = 1;
  }

  $machine['#field_prefix'] = '<span dir="ltr">' . check_plain($display_prefix) . '</span>&lrm;';
  $machine['#maxlength'] = $max_length;
  $machine['#field_tweaks_prefix'] = $prefix;
  $machine['#element_validate'][] = 'field_tweaks_add_new_field_prefix_validate';

  // Clarify description with the current prefix.
  $machine['#description'] = t('A unique machine-readable name containing letters, numbers, and underscores. Suggested prefix: @prefix', array('@prefix' => $display_prefix));
}

/**
 * Implements hook_menu().
 */
function field_tweaks_menu() {
  $items = array();

  // Secondary tabs for content type Manage fields.
  $items['admin/structure/types/manage/%node_type/fields/overview'] = array(
    'title' => 'Overview',
    'type' => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -99,
    'access callback' => 'user_access',
    'access arguments' => array('administer fields'),
  );

  $items['admin/structure/types/manage/%node_type/fields/tweaks'] = array(
    'title' => 'Settings',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('field_tweaks_bundle_settings_form', 'node', 4),
    'type' => MENU_LOCAL_TASK,
    'weight' => -98,
    'access callback' => 'user_access',
    'access arguments' => array('administer fields'),
  );

  return $items;
}

/**
 * Form for per-bundle Field Tweaks settings.
 */
function field_tweaks_bundle_settings_form($form, &$form_state, $entity_type, $bundle) {
  // Normalize bundle to machine name string.
  if (is_object($bundle) && isset($bundle->type)) {
    $bundle_name = $bundle->type;
  }
  else {
    $bundle_name = $bundle;
  }

  $config = config('field_tweaks.settings');
  $bundle_settings = $config->get('bundle_settings');
  if (!is_array($bundle_settings)) {
    $bundle_settings = array();
  }

  $defaults = array(
    'suggest_bundle_prefix' => FALSE,
    'machine_name_prefix' => $bundle_name,
    'trim_mode' => 'off',
  );
  $current = !empty($bundle_settings[$bundle_name]) ? $bundle_settings[$bundle_name] : array();
  $settings = $current + $defaults;

  $form['bundle'] = array(
    '#type' => 'value',
    '#value' => $bundle_name,
  );
  $form['entity_type'] = array(
    '#type' => 'value',
    '#value' => $entity_type,
  );

  $form['field_tweaks'] = array(
    '#type' => 'fieldset',
    '#title' => t('Field Tweaks'),
    '#description' => t('Opt-in helpers for machine name suggestions and trimming text values for this content type.'),
    '#tree' => TRUE,
  );

  $form['field_tweaks']['suggest_bundle_prefix'] = array(
    '#type' => 'checkbox',
    '#title' => t('Suggest bundle-prefixed machine names'),
    '#default_value' => $settings['suggest_bundle_prefix'],
    '#description' => t('When creating a new field on this content type, suggest machine names that include the bundle machine name (planned).'),
  );

  $form['field_tweaks']['machine_name_prefix'] = array(
    '#type' => 'textfield',
    '#title' => t('Suggested machine name prefix'),
    '#default_value' => $settings['machine_name_prefix'],
    '#size' => 24,
    '#maxlength' => 32,
    '#description' => t('Prefix to prepend when suggesting new field machine names. Defaults to the bundle machine name; can be shortened (for example, @example).', array('@example' => $bundle_name ? $bundle_name : 'post')),
    '#states' => array(
      'visible' => array(
        ':input[name="field_tweaks[suggest_bundle_prefix]"]' => array('checked' => TRUE),
      ),
    ),
  );

  $form['field_tweaks']['trim_text_on_save'] = array(
    '#type' => 'radios',
    '#title' => t('Trim text values on save'),
    '#default_value' => $settings['trim_mode'],
    '#options' => array(
      'off' => t('Do not trim'),
      'all' => t('Trim all text fields on this content type'),
      'per_field' => t('Allow trimming to be enabled per field'),
    ),
    '#description' => t('Remove leading and trailing whitespace from text-based fields on save. Choose global trimming or enable per-field control.'),
  );

  $form['actions'] = array('#type' => 'actions');
  $form['actions']['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Save settings'),
  );

  return $form;
}

/**
 * Submit handler for bundle settings form.
 */
function field_tweaks_bundle_settings_form_submit($form, &$form_state) {
  $bundle = $form_state['values']['bundle'];
  $config = config('field_tweaks.settings');
  $bundle_settings = $config->get('bundle_settings');
  if (!is_array($bundle_settings)) {
    $bundle_settings = array();
  }

  $values = isset($form_state['values']['field_tweaks']) ? $form_state['values']['field_tweaks'] : array();
  $prefix = isset($values['machine_name_prefix']) ? trim($values['machine_name_prefix']) : '';
  if ($prefix === '' && $bundle) {
    $prefix = $bundle;
  }
  $prefix = field_tweaks_sanitize_machine_prefix($prefix);
  $bundle_settings[$bundle] = array(
    'suggest_bundle_prefix' => !empty($values['suggest_bundle_prefix']),
    'machine_name_prefix' => $prefix,
    'trim_mode' => isset($values['trim_text_on_save']) ? $values['trim_text_on_save'] : 'off',
  );

  $config->set('bundle_settings', $bundle_settings);
  $config->save();

  backdrop_set_message(t('Field Tweaks settings saved.'));
}

/**
 * Trim text fields on presave according to bundle/field settings.
 *
 * Supports bundle-level modes (off, all text fields, per-field) and a
 * per-instance checkbox for text fields (backdrop/backdrop-issues#6386).
 */
function field_tweaks_field_attach_presave($entity_type, $entity) {
  $bundle = field_extract_bundle($entity_type, $entity);

  $config = config('field_tweaks.settings');
  $bundle_settings = $config->get('bundle_settings');
  $trim_mode = isset($bundle_settings[$bundle]['trim_mode']) ? $bundle_settings[$bundle]['trim_mode'] : 'off';
  if ($trim_mode === 'off') {
    return;
  }

  $instances = field_info_instances($entity_type, $bundle);
  if (empty($instances)) {
    return;
  }

  $text_types = array('text', 'text_long', 'text_with_summary');

  foreach ($instances as $field_name => $instance) {
    $field = field_info_field($field_name);
    if (!$field || !in_array($field['type'], $text_types, TRUE)) {
      continue;
    }

    // If per-field mode is enabled, honor the instance toggle.
    if ($trim_mode === 'per_field') {
      $instance_setting = !empty($instance['settings']['field_tweaks_trim']) ? TRUE : FALSE;
      if (!$instance_setting) {
        continue;
      }
    }

    $langcode = field_language($entity_type, $entity, $field_name);
    if (empty($langcode) || empty($entity->{$field_name}[$langcode])) {
      continue;
    }

    foreach ($entity->{$field_name}[$langcode] as &$item) {
      if (isset($item['value']) && is_string($item['value'])) {
        $item['value'] = field_tweaks_trim_edges($item['value']);
      }
      if (isset($item['summary']) && is_string($item['summary'])) {
        $item['summary'] = field_tweaks_trim_edges($item['summary']);
      }
    }
  }
}

/**
 * Implements hook_field_instance_settings_form().
 */
function field_tweaks_field_instance_settings_form($field, $instance) {
  $text_types = array('text', 'text_long', 'text_with_summary');
  if (!in_array($field['type'], $text_types, TRUE)) {
    return array();
  }

  $config = config('field_tweaks.settings');
  $bundle_settings = $config->get('bundle_settings');
  $bundle = $instance['bundle'];
  $trim_mode = isset($bundle_settings[$bundle]['trim_mode']) ? $bundle_settings[$bundle]['trim_mode'] : 'off';

  if ($trim_mode !== 'per_field') {
    return array();
  }

  $form['field_tweaks_trim'] = array(
    '#type' => 'checkbox',
    '#title' => t('Trim leading/trailing whitespace on save'),
    '#default_value' => !empty($instance['settings']['field_tweaks_trim']),
    '#description' => t('If checked, values for this field will be trimmed when saved.'),
  );

  return $form;
}

/**
 * Implements hook_form_FORM_ID_alter() for field_ui_field_edit_form.
 */
function field_tweaks_form_field_ui_field_edit_form_alter(&$form, &$form_state, $form_id) {
  if (empty($form['#field']) || empty($form['#instance'])) {
    return;
  }
  $field = $form['#field'];
  $instance = $form['#instance'];

  $text_types = array('text', 'text_long', 'text_with_summary');
  if (!in_array($field['type'], $text_types, TRUE)) {
    return;
  }

  $config = config('field_tweaks.settings');
  $bundle_settings = $config->get('bundle_settings');
  $bundle = $instance['bundle'];
  $trim_mode = isset($bundle_settings[$bundle]['trim_mode']) ? $bundle_settings[$bundle]['trim_mode'] : 'off';
  if ($trim_mode !== 'per_field') {
    return;
  }

  if (!isset($form['instance']['settings']) || !is_array($form['instance']['settings'])) {
    $form['instance']['settings'] = array();
  }

  $form['instance']['settings']['field_tweaks_trim'] = array(
    '#type' => 'checkbox',
    '#title' => t('Trim leading/trailing whitespace on save'),
    '#default_value' => !empty($instance['settings']['field_tweaks_trim']),
    '#description' => t('If checked, values for this field will be trimmed when saved.'),
    '#weight' => 50,
  );
}

/**
 * Sanitizes a machine name prefix fragment.
 */
function field_tweaks_sanitize_machine_prefix($prefix) {
  $prefix = backdrop_strtolower($prefix);
  $prefix = preg_replace('/[^a-z0-9_]+/', '_', $prefix);
  $prefix = trim($prefix, '_');
  // Collapse multiple underscores.
  $prefix = preg_replace('/_+/', '_', $prefix);
  return $prefix;
}

/**
 * Trim helper for field values (leading/trailing only).
 */
function field_tweaks_trim_edges($value) {
  return trim($value);
}

/**
 * Element validate: prepend configured prefix to new field machine names.
 */
function field_tweaks_add_new_field_prefix_validate($element, &$form_state, $form) {
  if (empty($element['#field_tweaks_prefix'])) {
    return;
  }
  $prefix = $element['#field_tweaks_prefix'];
  $value = isset($element['#value']) ? trim($element['#value']) : '';
  if ($value === '') {
    return;
  }

  // Avoid double-prefixing if the user typed it manually.
  $prefixed_value = (strpos($value, $prefix . '_') === 0) ? $value : $prefix . '_' . $value;
  form_set_value($element, $prefixed_value, $form_state);
}
